{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["resources/app/*"]
    }
  },
  "include": [
    "resources/app",
    "resources/js",
    "global.d.ts", 
    "resources/integrations/vite-env.d.ts"
, "resources/integrations/google/googleConfig.ts",
    "resources/integrations/google/google.ts"
  ]
}